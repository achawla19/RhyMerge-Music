# ── Database ─────────────────────────────────────────────────────────────
# MongoDB Atlas connection string. In Atlas: Database > Connect > Drivers.
# Use a dedicated app user (not your Atlas account login), and make sure
# Network Access allows connections from Render's IPs (0.0.0.0/0 is the
# simplest option since Render's outbound IPs aren't static on most plans —
# fine because access is still gated by the username/password in the URI).
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/rhymerge?retryWrites=true&w=majority

# ── Auth ─────────────────────────────────────────────────────────────────
# Two DIFFERENT random secrets — never reuse one for both. Generate each with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_REFRESH_SECRET=

# ── Message encryption (AES-256-GCM) ────────────────────────────────────
# Must be exactly 64 hex characters (32 bytes). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# CRITICAL: back this up somewhere safe outside the deploy platform. If you
# ever lose it or rotate it without a migration, every existing message in
# the database becomes permanently undecryptable — decrypt() returns null
# for all of them, not an error you can recover from.
MESSAGE_ENCRYPTION_KEY=

# ── Cloudinary (all media: avatars, covers, stems, message attachments) ──
# Cloudinary dashboard home screen shows this as one combined string.
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>

# ── Email (Resend) — optional, notifications degrade gracefully without it
RESEND_API_KEY=
RESEND_FROM_EMAIL="RhyMerge <notifications@yourdomain.com>"

# ── AI features (trending creators, AI insights panel) ─────────────────
ANTHROPIC_API_KEY=

# ── App ──────────────────────────────────────────────────────────────────
# The deployed frontend URL — used for CORS origin checks AND for building
# links inside emails. Must match your actual Vercel URL exactly, including
# https:// and no trailing slash.
CLIENT_URL=https://your-app.vercel.app

NODE_ENV=production
PORT=5000